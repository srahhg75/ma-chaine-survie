 "phrases": [
  {
   "id": "hook",
   "index": 0,
   "chute": false,
   "texte": "Que feriez-vous si votre robinet crachait de l'air ?",
   "debut": 0.0,
   "fin": 2.4,
   "fDebut": 0,
   "fFin": 72,
   "premierMot": 0,
   "dernierMot": 7
  },
  {
   "id": "hook2",
   "index": 1,
   "chute": false,
   "texte": "Et qu'il vous restait neuf litres d'eau ?",
   "debut": 2.67,
   "fin": 4.26,
   "fDebut": 80,
   "fFin": 128,
   "premierMot": 8,
   "dernierMot": 14
  },
  {
   "id": "recap1",
   "index": 2,
   "chute": false,
   "texte": "Trois jours sans électricité dans toute la ville.",
   "debut": 4.53,
   "fin": 6.63,
   "fDebut": 136,
   "fFin": 199,
   "premierMot": 15,
   "dernierMot": 22
  },
  {
   "id": "recap2",
   "index": 3,
   "chute": false,
   "texte": "Sans courant, la pompe de l'immeuble s'arrête.",
   "debut": 6.9,
   "fin": 9.33,
   "fDebut": 207,
   "fFin": 280,
   "premierMot": 23,
   "dernierMot": 29
  },
  {
   "id": "recap3",
   "index": 4,
   "chute": false,
   "texte": "L'eau ne monte plus au sixième, chez Inès.",
   "debut": 9.63,
   "fin": 12.18,
   "fDebut": 289,
   "fFin": 365,
   "premierMot": 30,
   "dernierMot": 37
  },
  {
   "id": "promesse",
   "index": 5,
   "chute": false,
   "texte": "Inès connaît trois réserves cachées.",
   "debut": 12.48,
   "fin": 14.31,
   "fDebut": 374,
   "fFin": 429,
   "premierMot": 38,
   "dernierMot": 42
  },
  {
   "id": "promesse2",
   "index": 6,
   "chute": false,
   "texte": "La dernière vaut deux cents litres.",
   "debut": 14.85,
   "fin": 16.29,
   "fDebut": 446,
   "fFin": 489,
   "premierMot": 43,
   "dernierMot": 48
  },
  {
   "id": "t1",
   "index": 7,
   "chute": false,
   "texte": "Un : manger mouillé.",
   "debut": 16.56,
   "fin": 17.82,
   "fDebut": 497,
   "fFin": 535,
   "premierMot": 49,
   "dernierMot": 51
  },
  {
   "id": "t1a",
   "index": 8,
   "chute": false,
   "texte": "Pêches au sirop, ananas, haricots en boîte.",
   "debut": 18.06,
   "fin": 20.58,
   "fDebut": 542,
   "fFin": 617,
   "premierMot": 52,
   "dernierMot": 58
  },
  {
   "id": "t1b",
   "index": 9,
   "chute": false,
   "texte": "Leur jus hydrate.",
   "debut": 20.85,
   "fin": 21.87,
   "fDebut": 626,
   "fFin": 656,
   "premierMot": 59,
   "dernierMot": 61
  },
  {
   "id": "t1c",
   "index": 10,
   "chute": false,
   "texte": "Et zéro chips, zéro saucisson.",
   "debut": 22.14,
   "fin": 24.03,
   "fDebut": 664,
   "fFin": 721,
   "premierMot": 62,
   "dernierMot": 66
  },
  {
   "id": "t1d",
   "index": 11,
   "chute": false,
   "texte": "Le sel donne soif.",
   "debut": 24.3,
   "fin": 25.38,
   "fDebut": 729,
   "fFin": 761,
   "premierMot": 67,
   "dernierMot": 70
  },
  {
   "id": "t2",
   "index": 12,
   "chute": false,
   "texte": "Deux : les toilettes.",
   "debut": 25.44,
   "fin": 26.64,
   "fDebut": 763,
   "fFin": 799,
   "premierMot": 71,
   "dernierMot": 73
  },
  {
   "id": "t2a",
   "index": 13,
   "chute": false,
   "texte": "Une chasse d'eau, c'est neuf litres.",
   "debut": 26.94,
   "fin": 28.38,
   "fDebut": 808,
   "fFin": 851,
   "premierMot": 74,
   "dernierMot": 79
  },
  {
   "id": "t2b",
   "index": 14,
   "chute": false,
   "texte": "Toute sa réserve, d'un coup.",
   "debut": 28.65,
   "fin": 29.88,
   "fDebut": 860,
   "fFin": 896,
   "premierMot": 80,
   "dernierMot": 84
  },
  {
   "id": "t2c",
   "index": 15,
   "chute": false,
   "texte": "Alors elle se lave au-dessus d'une bassine.",
   "debut": 30.18,
   "fin": 32.01,
   "fDebut": 905,
   "fFin": 960,
   "premierMot": 85,
   "dernierMot": 91
  },
  {
   "id": "t2d",
   "index": 16,
   "chute": false,
   "texte": "Et cette eau sale finit dans la cuvette.",
   "debut": 32.31,
   "fin": 34.44,
   "fDebut": 969,
   "fFin": 1033,
   "premierMot": 92,
   "dernierMot": 99
  },
  {
   "id": "t2e",
   "index": 17,
   "chute": false,
   "texte": "Versée d'un coup, la cuvette se vide.",
   "debut": 34.71,
   "fin": 36.81,
   "fDebut": 1041,
   "fFin": 1104,
   "premierMot": 100,
   "dernierMot": 106
  },
  {
   "id": "t3",
   "index": 18,
   "chute": false,
   "texte": "Trois : le ballon d'eau chaude.",
   "debut": 37.11,
   "fin": 38.67,
   "fDebut": 1113,
   "fFin": 1160,
   "premierMot": 107,
   "dernierMot": 111
  },
  {
   "id": "t3a",
   "index": 19,
   "chute": false,
   "texte": "Deux cents litres, dans le placard.",
   "debut": 38.97,
   "fin": 40.32,
   "fDebut": 1169,
   "fFin": 1210,
   "premierMot": 112,
   "dernierMot": 117
  },
  {
   "id": "t3b",
   "index": 20,
   "chute": false,
   "texte": "On coupe son disjoncteur.",
   "debut": 40.83,
   "fin": 42.15,
   "fDebut": 1225,
   "fFin": 1264,
   "premierMot": 118,
   "dernierMot": 121
  },
  {
   "id": "t3c",
   "index": 21,
   "chute": false,
   "texte": "On ferme l'eau froide.",
   "debut": 42.42,
   "fin": 43.5,
   "fDebut": 1273,
   "fFin": 1305,
   "premierMot": 122,
   "dernierMot": 125
  },
  {
   "id": "t3d",
   "index": 22,
   "chute": false,
   "texte": "On ouvre un robinet d'eau chaude.",
   "debut": 43.77,
   "fin": 45.27,
   "fDebut": 1313,
   "fFin": 1358,
   "premierMot": 126,
   "dernierMot": 131
  },
  {
   "id": "t3e",
   "index": 23,
   "chute": false,
   "texte": "Et on vide par le robinet du bas.",
   "debut": 45.57,
   "fin": 47.07,
   "fDebut": 1367,
   "fFin": 1412,
   "premierMot": 132,
   "dernierMot": 139
  },
  {
   "id": "t3f",
   "index": 24,
   "chute": false,
   "texte": "Un filtre à café retient les dépôts.",
   "debut": 47.34,
   "fin": 49.439,
   "fDebut": 1420,
   "fFin": 1483,
   "premierMot": 140,
   "dernierMot": 146
  },
  {
   "id": "erreur",
   "index": 25,
   "chute": false,
   "texte": "Surtout, jamais l'eau des radiateurs.",
   "debut": 49.74,
   "fin": 51.81,
   "fDebut": 1492,
   "fFin": 1554,
   "premierMot": 147,
   "dernierMot": 151
  },
  {
   "id": "erreur2",
   "index": 26,
   "chute": false,
   "texte": "Elle tourne en circuit fermé depuis des années.",
   "debut": 52.11,
   "fin": 54.18,
   "fDebut": 1563,
   "fFin": 1625,
   "premierMot": 152,
   "dernierMot": 159
  },
  {
   "id": "erreur3",
   "index": 27,
   "chute": false,
   "texte": "Brune, pleine de produits anti-rouille.",
   "debut": 54.45,
   "fin": 56.58,
   "fDebut": 1634,
   "fFin": 1697,
   "premierMot": 160,
   "dernierMot": 164
  },
  {
   "id": "erreur4",
   "index": 28,
   "chute": false,
   "texte": "Même bouillie, elle n'est pas potable.",
   "debut": 56.85,
   "fin": 58.56,
   "fDebut": 1706,
   "fFin": 1757,
   "premierMot": 165,
   "dernierMot": 170
  },
  {
   "id": "calme",
   "index": 29,
   "chute": false,
   "texte": "Inès, elle, est tranquille.",
